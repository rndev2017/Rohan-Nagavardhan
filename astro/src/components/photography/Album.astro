---
import SanityDescription from "../SanityDescription.astro";

const { id, title, description, isUploading, startedAt, endedAt } = Astro.props;

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })
}
const dateRange = startedAt
  ? `${formatDate(startedAt)} – ${endedAt ? formatDate(endedAt) : 'present'}`
  : null
---

<article class="border-t border-photo-border py-photo-md">
    <h3 class="mb-photo-xs text-[1.375rem]"><a href={`/albums/${id}`}>{title}</a></h3>
    {isUploading && <p class="font-photo-mono text-xs text-photo-muted">Uploading…</p>}
    {dateRange && <p class="font-photo-mono text-xs text-photo-muted">{dateRange}</p>}
    <div class="mt-photo-xs text-[0.8125rem] text-photo-muted [overflow-wrap:anywhere] [&_p+p]:mt-photo-xs [&_a]:underline [&_a]:underline-offset-[0.2em]">
        <SanityDescription text={description}/>
    </div>
</article>
