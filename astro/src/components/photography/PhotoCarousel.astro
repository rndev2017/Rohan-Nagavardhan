---
import Photo from './Photo.astro';
import type { PhotoDocument } from '../../lib/queries';

interface Props {
  photos: PhotoDocument[];
}

const photos = Astro.props.photos.filter(Boolean);
---

<div id="photo-carousel" role="region" aria-label="Album photographs">
  {photos.length === 0 ? <p class="text-photo-muted">No photographs in this project yet.</p> : (
    <>
      <div>
        {photos.map((photo, i) => (
          <div class="carousel-slide" hidden={i !== 0}>
            <Photo node={photo}/>
          </div>
        ))}
      </div>
      <div class="mt-photo-lg flex items-center justify-center gap-photo-md">
        <button class="p-photo-xs text-[0.8125rem] disabled:cursor-not-allowed disabled:text-photo-muted disabled:opacity-[0.55]" id="prev-btn" type="button" aria-label="Previous photograph" disabled>prev</button>
        <span id="carousel-counter" class="font-photo-mono text-xs text-photo-muted" aria-live="polite" aria-atomic="true">1 / {photos.length}</span>
        <button class="p-photo-xs text-[0.8125rem] disabled:cursor-not-allowed disabled:text-photo-muted disabled:opacity-[0.55]" id="next-btn" type="button" aria-label="Next photograph" disabled={photos.length <= 1}>next</button>
      </div>
    </>
  )}
</div>

<script>
  const carousel = document.getElementById('photo-carousel');
  const slides = carousel?.querySelectorAll<HTMLElement>('.carousel-slide');
  const prevBtn = carousel?.querySelector<HTMLButtonElement>('#prev-btn');
  const nextBtn = carousel?.querySelector<HTMLButtonElement>('#next-btn');
  const counter = carousel?.querySelector<HTMLElement>('#carousel-counter');

  if (slides?.length && prevBtn && nextBtn && counter) {
    const total = slides.length;
    let current = 0;

    function show(index: number) {
      if (index < 0 || index >= total) return;
      slides![current].hidden = true;
      current = index;
      slides![current].hidden = false;
      counter!.textContent = `${current + 1} / ${total}`;
      prevBtn!.disabled = current === 0;
      nextBtn!.disabled = current === total - 1;
    }

    prevBtn.addEventListener('click', () => show(current - 1));
    nextBtn.addEventListener('click', () => show(current + 1));
    document.addEventListener('keydown', (event) => {
      if (event.target instanceof Element && event.target.closest('input, textarea, select, [contenteditable]')) return;
      if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      if (event.key === 'ArrowLeft') { event.preventDefault(); show(current - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); show(current + 1); }
    });
  }
</script>
