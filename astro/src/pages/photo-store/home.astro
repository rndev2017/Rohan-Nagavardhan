---
const scenario = Astro.url.searchParams.get('scenario') || null;

const showBizPhone = scenario === null || scenario === "biz_phone"
const showBizAddress = scenario === null || scenario === "biz_address"
---

<body class="h-screen bg-parchment-500 font-serif p-5">
    <!-- Nav Bar -->
    <div class="flex justify-between items-center">
        <!-- Business Name  -->
        <div class="text-jet-500 text-3xl font-bold tracking-tight">
            <p>Rohan's Darkroom</p>
        </div>
    </div>


    <!-- Content -->
    <div class="h-svh text-jet-500">
        <div id="#products" class="w-full space-y-5 my-6">
            <h2 class="text-2xl font-bold tracking-tight">Products</h2>
            <div class="flex justify-center space-x-8">
                <!-- Product box -->
                <div class="border-jet border-4 p-8 rounded-lg w-1/3 hover:border-pumpkin-400 hover:bg-pumpkin-500/5">
                    <div class="flex flex-col items-center space-y-4">
                        <img class="h-32 w-32" src="/images/film_roll.png" />
                        <div class="flex flex-col items-center space-y-2">
                            <p>Film Development & Scanning</p>
                            <p class="text-xl">$30 / roll</p>
                        </div>
                    </div>
                </div>

                <!-- Product box -->
                <div class="border-jet border-4 p-8 rounded-lg w-1/3 hover:border-pumpkin-400 hover:bg-pumpkin-500/5">
                    <div class="flex flex-col items-center space-y-4">
                        <img class="h-32 w-32" src="/images/photo_prints.png" />
                        <div class="flex flex-col items-center space-y-2">
                            <p>Photo Prints</p>
                            <p class="text-xl">$1 / print</p>
                        </div>
                    </div>
                </div>

                <!-- Product box -->
                <div class="border-jet border-4 p-8 rounded-lg w-1/3 hover:border-pumpkin-400 hover:bg-pumpkin-500/5">
                    <div class="flex flex-col items-center space-y-4">
                        <img class="h-32 w-32" src="/images/photo_album.png" />
                        <div class="flex flex-col items-center space-y-2">
                            <p>Photo Albums</p>
                            <p class="text-xl">$100 / album</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="#about" class="space-y-5 my-6">
            <h2 class="text-2xl font-bold tracking-tight">About Us</h2>
            <p class="leading-relaxed text-lg">
            Welcome to <span class="text-pumpkin-400 font-semibold">Rohan's Darkroom</span>! My name is Rohan, and I started this business to create a space for film lovers like myself. In a world of digital immediacy, I believe there's still a place for the careful, hands-on process of film development. My goal is to offer a reliable and professional service that honors the craftsmanship of traditional photography.
            </p>
        </div>

        <div id="#contact" class="space-y-5 my-6">
            <h2 class="text-2xl font-bold tracking-tight">Contact</h2>
            <div class="space-y-2">
                {showBizPhone
                    ?
                        (<p>
                            <span class="italic underline">Store Phone Number</span> 
                                &middot;
                            <span class="text-pumpkin-400">(206) 555-0199</span>
                        <p/>)
                    : null
                }
    
                {showBizAddress
                    ?
                        (<p>
                            <span class="italic underline">Store Location</span> 
                                &middot;
                            <span class="text-pumpkin-400">1401 Pine Street, Seattle, WA 98101</span>
                        <p/>)
                    : null
                }
                
                <p>
                    <span class="italic underline">Customer Service Phone Number</span> 
                        &middot; 
                    <span class="italic underline text-pumpkin-400">(800) 555-0199</span>
                </p>
            </div>
        </div>
    </div>
</body>
