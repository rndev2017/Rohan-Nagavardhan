---
import PhotoLayout from '../../layouts/PhotoLayout.astro';
import {getProjects} from '../../lib/queries';
import ProjectBook from '../../components/photography/ProjectBook.astro';

const projects = await getProjects();
---

<PhotoLayout title="Photography projects · Rohan Nagavardhan">
  <div class="max-w-photo-page">
    <h1 class="mb-photo-lg text-photo-title">Projects</h1>
    {projects.length ? (
      <ul class="grid grid-cols-1 gap-x-photo-xl gap-y-photo-xl sm:grid-cols-[repeat(auto-fill,16rem)]">
        {projects.map((project) => (
          <li class="w-full max-w-[14rem] sm:max-w-[16rem]">
            <a data-project-link href={`/photos/projects/${project.slug.current}`} aria-label={`Open ${project.title}`} class="mb-photo-md block hover:!no-underline">
              <ProjectBook title={project.title} thumbnail={project.thumbnail} />
            </a>
            <h2 class="mb-photo-xs break-words text-photo-heading">
              <a data-project-title href={`/photos/projects/${project.slug.current}`} class="decoration-photo-border underline underline-offset-4">{project.title}</a>
            </h2>
            <p class="mb-photo-xs font-sans text-photo-utility text-photo-muted">
              {project.status === 'in_progress' ? 'In progress' : 'Complete'}
            </p>
            {project.description && <p class="font-sans text-photo-summary text-photo-muted">{project.description}</p>}
          </li>
        ))}
      </ul>
    ) : (
      <div class="mx-auto flex min-h-[50svh] max-w-[24rem] flex-col items-center justify-center py-photo-lg text-center">
        <button type="button" data-empty-portrait aria-label="Take a photo" title="Take a photo" class="empty-portrait relative mb-photo-md h-32 w-32 cursor-pointer">
          <span class="camera-poses absolute inset-0 [image-rendering:pixelated]" role="img" aria-label="Pixel-art portrait of Rohan raising a camera to his eye"></span>
          <span class="camera-flash" aria-hidden="true"></span>
        </button>
        <span data-photo-status class="sr-only" role="status"></span>
        <h2 class="mb-photo-xs text-photo-heading">No projects yet.</h2>
        <p class="font-sans text-photo-summary text-photo-muted">
          <span class="block">I'm out in the field making photographs.</span>
          <span class="block">Check back soon.</span>
        </p>
      </div>
    )}
  </div>
</PhotoLayout>

<script>
  import {createCameraPoses} from '../../lib/camera-poses';

  // Decode every pose before playing the one-shot camera animation.
  const portrait = document.querySelector<HTMLElement>('[data-empty-portrait]');
  if (portrait) {
    const poses = new Image();
    poses.src = '/images/photography-camera-poses-v2.png';
    poses.decode().then(() => { portrait.dataset.ready = ''; }).catch(() => {});
    const sprite = portrait.querySelector<HTMLElement>('.camera-poses')!;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const controller = createCameraPoses((frame) => {
      portrait.style.setProperty('--camera-position', `${frame * 50}%`);
    });
    const takeOver = () => {
      if (portrait.hasAttribute('data-played')) return;
      // Read the visible cell before cancelling the entrance animation.
      controller.adopt(parseFloat(getComputedStyle(sprite).backgroundPositionX) || 0);
      portrait.dataset.played = '';
    };
    portrait.addEventListener('animationend', (event) => {
      // Astro scopes keyframe names; identify the animated element instead.
      if (event.target === sprite) takeOver();
    });
    window.addEventListener('pagehide', () => controller.cancel(), {once: true});
    portrait.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'touch' || !matchMedia('(hover: hover)').matches) return;
      // Hover takes over without replaying the entrance flash on pointer leave.
      takeOver();
      portrait.dataset.hovering = '';
      if (!motion.matches) controller.move(2);
    });
    portrait.addEventListener('pointerleave', () => {
      delete portrait.dataset.hovering;
      if (!takingPhoto) controller.move(0);
    });
    let takingPhoto = false;
    portrait.addEventListener('click', async () => {
      if (takingPhoto || !portrait.hasAttribute('data-ready')) return;
      takingPhoto = true;
      takeOver();
      const status = document.querySelector<HTMLElement>('[data-photo-status]');
      if (status) status.textContent = '';
      portrait.dataset.shooting = '';
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      try {
        if (!reducedMotion) {
          controller.move(2);
          const flash = portrait.querySelector<HTMLElement>('.camera-flash')!;
          await flash.animate([{opacity: 0}, {opacity: 1, offset: 0.2}, {opacity: 1, offset: 0.55}, {opacity: 0}], {
            delay: 360, duration: 220, easing: 'steps(2, end)',
          }).finished;
        }
        if (status) status.textContent = 'Photo taken.';
        await new Promise((resolve) => setTimeout(resolve, 400));
      } finally {
        delete portrait.dataset.shooting;
        takingPhoto = false;
        controller.move(portrait.hasAttribute('data-hovering') && !motion.matches ? 2 : 0);
      }
    });
  }

  import {rememberProjectOpening} from '../../lib/project-opening';
  document.querySelectorAll<HTMLAnchorElement>('[data-project-link], [data-project-title]').forEach((link) => {
    link.addEventListener('click', (event) => rememberProjectOpening(event, link));
  });
</script>

<style>
  .camera-poses {
    background: url('/images/photography-camera-poses-v2.png') 0 0 / 300% 100% no-repeat;
  }

  .camera-flash {
    position: absolute;
    left: 70%;
    top: 33%;
    width: 22px;
    height: 22px;
    background: #fffdf5;
    clip-path: polygon(40% 0, 60% 0, 60% 30%, 70% 30%, 70% 40%, 100% 40%, 100% 60%, 70% 60%, 70% 70%, 60% 70%, 60% 100%, 40% 100%, 40% 70%, 30% 70%, 30% 60%, 0 60%, 0 40%, 30% 40%, 30% 30%, 40% 30%);
    transform: translate(-50%, -50%);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .empty-portrait[data-ready]:not([data-played]) .camera-poses {
      animation: raise-camera 2200ms steps(1, end) 400ms 1;
    }
    .empty-portrait[data-ready]:not([data-played]) .camera-flash {
      animation: shutter-flash 220ms steps(2, end) 1450ms 1;
    }
  }

  .empty-portrait[data-played] .camera-poses {
    background-position: var(--camera-position, 0%) 0;
  }

  @keyframes raise-camera {
    0% { background-position: 0% 0; }
    20% { background-position: 50% 0; }
    35%, 65% { background-position: 100% 0; }
    75% { background-position: 50% 0; }
    90% { background-position: 0% 0; }
    100% { background-position: 0% 0; }
  }

  @keyframes shutter-flash {
    0% { opacity: 0; }
    20%, 55% { opacity: 1; }
    100% { opacity: 0; }
  }
</style>
