---
// @ts-ignore
import { sanityClient } from "sanity:client"
import PhotoCarousel from "../../components/PhotoCarousel.astro"
import Layout from "../../layouts/Layout.astro"

export interface PhotoDocument {
   title: string,
   location: string,
   description: unknown,
}

export interface AlbumWithPhotos {
   _id: string,
   title: string,
   description: unknown,
   photos: PhotoDocument[]
}

export const getStaticPaths = (async () => {
   const query = `*[_type == "album"] {_id, title, description, "photos": select(defined(photoSequence) && length(photoSequence) > 0 => photoSequence[]-> {title, location, description, photo, alt} [defined(photo)], *[_type == "photo" && references(^._id)] | order(_createdAt desc) {title, location, description, photo, alt})}`
   const albums: AlbumWithPhotos[] = await sanityClient.fetch(query)

   return albums.map((album) => {
       return {
         params: {id: album._id},
         props: {
            title: album.title,
            description: album.description,
            photos: album.photos
         }
       }
   })
})

const {photos, title} = Astro.props
---

<Layout title=`Albums · ${title}`, page="photos">
   <div class="flex flex-col h-[calc(100dvh-5rem)] overflow-hidden pr-5">
      <a href="/photos" class="block text-gray-600 underline hover:no-underline lowercase">&lt; Back</a>
      <PhotoCarousel photos={photos} class="flex-1 min-h-0" />
   </div>
</Layout>
