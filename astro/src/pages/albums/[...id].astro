---
import HeroIcon from '../../components/icons/HeroIcon.astro';
import PhotoLayout from '../../layouts/PhotoLayout.astro';

// Preserve previously published album URLs independently of the retired CMS model.
export function getStaticPaths() {
  return [
    '71cf934a-9864-48ae-b1e4-bd4471b902ae',
    '87ffe91f-0c5f-4fec-b586-d4ea93fc82b3',
  ].map((id) => ({ params: { id } }));
}
---

<PhotoLayout title="Photography project · Rohan Nagavardhan">
  <div class="max-w-photo-reading">
    <a href="/photos/projects" class="inline-flex min-h-11 items-center gap-photo-xs font-sans text-photo-utility text-photo-muted"><HeroIcon name="arrow-left" class="h-3 w-3" />Back to projects</a>
    <h1 class="mt-photo-sm mb-photo-lg text-photo-title">Project unavailable</h1>
    <p class="font-sans text-photo-summary text-photo-muted">New work is coming soon.</p>
  </div>
</PhotoLayout>
