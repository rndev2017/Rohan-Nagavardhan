---
import PhotoCarousel from "../../components/photography/PhotoCarousel.astro"
import PhotoLayout from "../../layouts/PhotoLayout.astro"
import { getAlbumsWithPhotos } from "../../lib/queries"

export const getStaticPaths = (async () => {
   const albums = await getAlbumsWithPhotos()

   return albums.map((album) => {
       const sequenced = album.sequencedPhotos?.filter(Boolean) ?? []
       const photos = sequenced.length ? sequenced : album.allPhotos
       return {
         params: {id: album._id},
         props: {
            title: album.title,
            description: album.description,
            photos
         }
       }
   })
})

const {photos, title} = Astro.props
---

<PhotoLayout title={`Albums · ${title}`}>
   <div>
      <a href="/photos" class="text-photo-muted text-[0.8125rem]">&lt; Back to projects</a>
      <h1 class="mt-photo-sm mb-photo-lg text-[clamp(1.75rem,4vw,2.5rem)]">{title}</h1>
      <PhotoCarousel photos={photos} />
   </div>
</PhotoLayout>
