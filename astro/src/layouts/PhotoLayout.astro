---
import SpeedInsights from '@vercel/speed-insights/astro';
import SiteHead from '../components/SiteHead.astro';
import PhotoHeader from '../components/photography/PhotoHeader.astro';

interface Props {
  title: string;
  description?: string;
  slideshow?: boolean;
  reader?: boolean;
}

const {
  title,
  slideshow = false,
  reader = false,
  description = 'Film, Polaroid, and digital photography by Rohan Nagavardhan.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead title={title} description={description} themeColor="#faf9f6" />
    <slot name="head" />
  </head>
  <body data-photo-reader={reader || undefined} data-photo-slideshow-page={slideshow || undefined} class:list={["photo-site bg-photo-background text-photo-foreground font-photo text-photo-body", (slideshow || reader) ? "flex h-svh min-h-0 flex-col" : "min-h-svh"]}>
    <a class="absolute z-[100] top-photo-xs left-photo-gutter -translate-y-[200%] bg-photo-background p-photo-xs focus:translate-y-0" href="#photo-content">Skip to content</a>
    {!reader && <PhotoHeader />}
    <main id="photo-content" class:list={[reader ? "w-full flex min-h-0 flex-1 flex-col px-photo-gutter py-photo-md" : "mx-auto w-full max-w-photo-page px-photo-gutter", reader ? "" : slideshow ? "flex min-h-0 flex-1 flex-col py-photo-md" : "pt-photo-lg pb-photo-xl"]} tabindex="-1">
      <slot />
    </main>
    <SpeedInsights />
  </body>
</html>

<style>
  /* Tokens are inherited only within the photography shell. */
  :global(.photo-site) {
    --photo-background: #faf9f6;
    --photo-foreground: #252522;
    --photo-muted: #66665f;
    --photo-border: #d8d7d0;
    --photo-accent: #66665f;
    --photo-surface: #f1f0ec;
    --photo-focus: #365e70;
    --photo-image-border: #53534d;
    --photo-font: Georgia, 'Times New Roman', serif;
    --photo-page-width: 72rem;
    --photo-reading-width: 42rem;
    --photo-space-xs: 0.5rem;
    --photo-space-sm: 1rem;
    --photo-space-md: 1.5rem;
    --photo-space-lg: 2rem;
    --photo-space-xl: 3rem;
    --photo-space-2xl: 4rem;
    --photo-gutter: clamp(1rem, 5vw, 3rem);
  }

  :global(.photo-site #photo-content) {
    padding-bottom: max(var(--photo-space-xl), env(safe-area-inset-bottom));
    padding-left: max(var(--photo-gutter), env(safe-area-inset-left));
    padding-right: max(var(--photo-gutter), env(safe-area-inset-right));
  }

  :global(.photo-site[data-photo-reader] #photo-content),
  :global(.photo-site[data-photo-slideshow-page] #photo-content) { padding-bottom: max(24px, env(safe-area-inset-bottom)); }

  @media (max-width: 767px) {
    :global(.photo-site[data-photo-reader] #photo-content),
    :global(.photo-site[data-photo-slideshow-page] #photo-content) { padding-bottom: max(16px, env(safe-area-inset-bottom)); }
  }
  @media (pointer: coarse) {
    :global(.photo-site > header a) { min-height: 44px; }
  }
  @media (max-height: 500px) and (pointer: coarse) {
    :global(.photo-site #photo-content) { padding-top: 8px; }
    :global(.photo-site[data-photo-reader] #photo-content),
    :global(.photo-site[data-photo-slideshow-page] #photo-content) { padding-bottom: max(8px, env(safe-area-inset-bottom)); }
    :global(.photo-site > header) { padding-top: 0; }
    :global(.photo-site > header > a) { margin-bottom: 0; }
    :global(.photo-site > header nav) { padding-bottom: 0; }
    :global([data-photo-reader] [data-reader-heading]) { margin-bottom: 8px; }
    :global([data-photo-reader] [data-reader-controls]) { margin-top: 8px; }
    :global([data-photo-viewer] [data-slide] > div) { padding-block: 8px; }
  }

  :global(:where(.photo-site) :where(h1, h2, h3)) {
    @apply font-normal leading-[1.15];
  }

  :global(.photo-site a:hover),
  :global(.photo-site button:enabled:hover) {
    @apply text-photo-accent underline underline-offset-[0.2em];
  }

  :global(.photo-site :focus-visible) {
    @apply outline outline-2 outline-photo-focus outline-offset-4;
  }
</style>
