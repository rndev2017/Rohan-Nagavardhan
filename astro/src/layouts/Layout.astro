---
import  SpeedInsights  from "@vercel/speed-insights/astro"
import NavLink from '../components/NavLink.astro';
import SiteHead from '../components/SiteHead.astro';

interface Props {
    title: string
    page: string
}

const { title, page } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<SiteHead title={title} />
	</head>
	<body class="text-xs font-serif">
		<div class="mt-5 ml-5 sm:text-xs md:text-sm">
			<div class="flex flex-row space-x-4 mr-4">
				<p>Rohan Nagavardhan</p>
				<div class="space-x-4">
					<NavLink active={page === "about"} href='/' text='About'/>
					<NavLink active={page === "blog"}  href='/blog' text='Blog'/>
					<NavLink active={page === "photos"} href='/photos' text='Photos'/>
				</div>
			</div>
			<div class="mt-8">
				<slot/>
			</div>
		</div>
		<SpeedInsights />	
	</body>
</html>
